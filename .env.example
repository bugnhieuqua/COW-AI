# ==============================================================================
# COW.AI - Environment Configuration Template (.env.example)
# ==============================================================================
# SAU KHI TẢI DỰ ÁN VỀ, SAO CHÉP FILE NÀY THÀNH .env HOẶC DÙNG DOTNET USER-SECRETS:
#   dotnet user-secrets set "OpenRouter:ApiKey" "sk-or-v1-your-key-here"
# TUYỆT ĐỐI KHÔNG COMMIT FILE .env CHỨA KEY THẬT LÊN GITHUB HOẶC KHO CHỨA CHUNG!
# ==============================================================================

# 1. OpenRouter API Configuration (AI Text & Reasoning Models)
OpenRouter__ApiKey=sk-or-v1-your-api-key-here
OpenRouter__BaseUrl=https://openrouter.ai/api/v1
OpenRouter__DefaultModel=google/gemini-2.0-flash-001

# 2. Pollinations AI Configuration (Free AI Image Generation)
Pollinations__BaseUrl=https://image.pollinations.ai/prompt/
Pollinations__DefaultWidth=1024
Pollinations__DefaultHeight=1024

# 3. Microsoft Edge Text-to-Speech (Free Realtime Speech Synthesis)
EdgeTTS__DefaultVoice=vi-VN-HoaiMyNeural
EdgeTTS__MaleVoice=vi-VN-NamMinhNeural
EdgeTTS__FemaleVoice=vi-VN-HoaiMyNeural

# 4. Search Engine Configuration
Search__Provider=DuckDuckGo
Search__MaxResults=5

# 5. Ollama Cloud & Local Configuration (Open-Weight Free Models)
Ollama__ApiKey=your_ollama_api_key_here
Ollama__BaseUrl=https://ollama.com/v1
Ollama__FallbackLocalUrl=http://localhost:11434/v1
Ollama__DefaultModel=gpt-oss:20b
Ollama__LocalDefaultModel=cow-ai:latest

# 6. Local Image Generation (stable-diffusion.cpp sd-server CUDA + SDXL Turbo)
LocalImage__BaseUrl=http://127.0.0.1:7860
LocalImage__ExecutablePath=D:\LocalImageAI\bin\sd-server.exe
LocalImage__ModelPath=D:\LocalImageAI\models\sd_xl_turbo_1.0_fp16.safetensors
LocalImage__VaePath=D:\LocalImageAI\models\sdxl_vae.safetensors
LocalImage__AutoStart=true

# 7. ASP.NET Core Runtime Settings
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://127.0.0.1:5223
