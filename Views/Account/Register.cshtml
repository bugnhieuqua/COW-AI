@model COW_AI.Models.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Đăng ký";
}

<section class="auth-page-container" aria-labelledby="registerHeading">
    <div class="auth-card glass-panel">
        <a href="/studio" class="auth-card__close-btn" title="Đóng và quay lại" aria-label="Đóng">&times;</a>
        <header class="auth-card__header">
            <div class="auth-brand-badge">
                <img src="~/images/logo.png" alt="COW.AI" width="36" height="36" class="auth-brand-badge__logo" />
                <span class="auth-brand-badge__title">COW.AI Account</span>
            </div>
            <h1 id="registerHeading" class="auth-card__title">Tạo tài khoản mới</h1>
            <p class="auth-card__subtitle">Bắt đầu trải nghiệm trợ lý AI đa năng và quản trị dự án cá nhân</p>
        </header>

        <form asp-controller="Account" asp-action="Register" method="post" class="auth-form" novalidate>
            @Html.AntiForgeryToken()

            @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
            {
                <div class="auth-alert auth-alert--error" role="alert" aria-live="polite">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="auth-alert__icon">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="12" y1="8" x2="12" y2="12"></line>
                        <line x1="12" y1="16" x2="12.01" y2="16"></line>
                    </svg>
                    <div class="auth-alert__content">
                        @foreach (var error in ViewData.ModelState[string.Empty]!.Errors)
                        {
                            <p>@error.ErrorMessage</p>
                        }
                    </div>
                </div>
            }

            <div class="form-row">
                <div class="form-group">
                    <label asp-for="Username" class="form-label">Tên đăng nhập <span class="required-star">*</span></label>
                    <div class="input-wrapper">
                        <span class="input-icon" aria-hidden="true">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                                <circle cx="12" cy="7" r="4"></circle>
                            </svg>
                        </span>
                        <input asp-for="Username" class="form-control" placeholder="vidu: dev_pro" autofocus autocomplete="username" />
                    </div>
                    <span asp-validation-for="Username" class="form-validation-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="FullName" class="form-label">Họ và tên <span class="required-star">*</span></label>
                    <div class="input-wrapper">
                        <span class="input-icon" aria-hidden="true">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="12" cy="12" r="10"></circle>
                                <path d="M12 8v8"></path>
                                <path d="M8 12h8"></path>
                            </svg>
                        </span>
                        <input asp-for="FullName" class="form-control" placeholder="Nguyễn Văn A" autocomplete="name" />
                    </div>
                    <span asp-validation-for="FullName" class="form-validation-error"></span>
                </div>
            </div>

            <div class="form-group">
                <label asp-for="Email" class="form-label">Địa chỉ Email <span class="required-star">*</span></label>
                <div class="input-wrapper">
                    <span class="input-icon" aria-hidden="true">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                            <polyline points="22,6 12,13 2,6"></polyline>
                        </svg>
                    </span>
                    <input asp-for="Email" type="email" class="form-control" placeholder="developer@domain.com" autocomplete="email" />
                </div>
                <span asp-validation-for="Email" class="form-validation-error"></span>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label asp-for="Password" class="form-label">Mật khẩu <span class="required-star">*</span></label>
                    <div class="input-wrapper">
                        <span class="input-icon" aria-hidden="true">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                            </svg>
                        </span>
                        <input asp-for="Password" type="password" id="regPassword" class="form-control password-input" placeholder="Tối thiểu 6 ký tự" autocomplete="new-password" />
                    </div>
                    <span asp-validation-for="Password" class="form-validation-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="ConfirmPassword" class="form-label">Xác nhận mật khẩu <span class="required-star">*</span></label>
                    <div class="input-wrapper">
                        <span class="input-icon" aria-hidden="true">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <polyline points="20 6 9 17 4 12"></polyline>
                            </svg>
                        </span>
                        <input asp-for="ConfirmPassword" type="password" id="regConfirmPassword" class="form-control password-input" placeholder="Nhập lại mật khẩu" autocomplete="new-password" />
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="form-validation-error"></span>
                </div>
            </div>

            <div class="password-notice">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="12" y1="16" x2="12" y2="12"></line>
                    <line x1="12" y1="8" x2="12.01" y2="8"></line>
                </svg>
                <span>Mật khẩu được mã hóa an toàn bằng thuật toán PBKDF2 của ASP.NET Core trước khi lưu vào SQLite cục bộ.</span>
            </div>

            <button type="submit" class="btn-auth-primary">
                <span>Đăng ký ngay</span>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
            </button>
        </form>

        <footer class="auth-card__footer">
            <p>Đã có tài khoản? <a asp-controller="Account" asp-action="Login" class="auth-link">Đăng nhập tại đây</a></p>
        </footer>
    </div>
</section>
