<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>@ViewData["Title"] - COW.AI</title>
    <meta name="description" content="@(ViewData["Description"] ?? "COW.AI - Nền tảng trợ lý AI đa tác vụ hàng đầu: Trò chuyện thông minh, sáng tạo hình ảnh, tóm tắt tài liệu văn bản và hỗ trợ lập trình viết code AI tốc độ cao.")" />
    <meta name="robots" content="@(ViewData["Robots"] ?? "index, follow")" />
    <meta name="theme-color" content="#09090b" />
    <link rel="canonical" href="@(ViewData["CanonicalUrl"] ?? $"https://cow.ai{Context.Request.Path}")" />
    <meta property="og:title" content="@ViewData["Title"]" />
    <meta property="og:description" content="@(ViewData["Description"] ?? "Trò chuyện AI, sinh hình ảnh, tóm tắt văn bản và hỗ trợ lập trình thông minh.")" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="COW.AI" />
    <meta property="og:locale" content="vi_VN" />
    <meta property="og:image" content="https://cow.ai/images/logo.png" />
    <meta property="og:url" content="@(ViewData["CanonicalUrl"] ?? $"https://cow.ai{Context.Request.Path}")" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@ViewData["Title"]" />
    <meta name="twitter:description" content="@(ViewData["Description"] ?? "Trò chuyện AI, sinh hình ảnh, tóm tắt văn bản và hỗ trợ lập trình thông minh.")" />
    <meta name="twitter:image" content="https://cow.ai/images/logo.png" />
    @await RenderSectionAsync("Head", required: false)
    <link rel="icon" type="image/png" href="~/images/logo.png" />
    <link rel="manifest" href="~/manifest.json" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/prism/prism-tomorrow.min.css" asp-append-version="true" />
    <script>
        (function () {
            var theme = localStorage.getItem('cowai_theme') || 'dark';
            var isDark = theme === 'dark' || (theme === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches);
            var root = document.documentElement;
            if (isDark) {
                root.classList.add('dark');
                root.classList.remove('light');
            } else {
                root.classList.add('light');
                root.classList.remove('dark');
            }
        })();
    </script>
</head>
<body data-tts-voice="vi-VN-HoaiMyNeural" 
      data-is-authenticated="@(User.Identity?.IsAuthenticated == true ? "true" : "false")"
      data-user-id="@(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "guest")" 
      data-user-name="@(User.Identity?.Name ?? "Khách")" 
      data-user-role="@(User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "Guest")">
    <script>
        (function () {
            if (document.documentElement.classList.contains('light')) {
                document.body.classList.add('light');
                document.body.classList.remove('dark');
            } else {
                document.body.classList.add('dark');
                document.body.classList.remove('light');
            }
            if (window.innerWidth >= 1024) {
                if (localStorage.getItem('cowai_sidebar_open') === 'false') {
                    document.body.classList.add('sidebar-collapsed');
                } else {
                    document.body.classList.add('sidebar-docked-open');
                }
            }
        })();
    </script>

    <div class="app-wrapper">
        <a href="#main-content" class="skip-to-content-link">Chuyển đến nội dung chính</a>
        <!-- Nút mở Sidebar chỉ hiện trên màn hình nhỏ / Mobile (< 1024px) vì đã bỏ Header -->
        <button type="button" id="toggleHistoryDrawerBtn" class="mobile-sidebar-trigger" aria-label="Mở bảng điều hướng" title="Mở bảng điều hướng" aria-expanded="false" aria-controls="chatHistoryDrawer">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="3" y1="12" x2="21" y2="12"></line>
                <line x1="3" y1="6" x2="21" y2="6"></line>
                <line x1="3" y1="18" x2="21" y2="18"></line>
            </svg>
        </button>

        @if (TempData["ToastSuccess"] != null || TempData["ToastInfo"] != null)
        {
            <div id="appToast" class="app-toast glass-panel animate-fade-in" role="status" aria-live="polite">
                <div class="app-toast__content">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="@(TempData["ToastSuccess"] != null ? "#34d399" : "#38bdf8")" stroke-width="2">
                        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                        <polyline points="22 4 12 14.01 9 11.01"></polyline>
                    </svg>
                    <span>@(TempData["ToastSuccess"] ?? TempData["ToastInfo"])</span>
                </div>
                <button type="button" class="app-toast__close" onclick="this.closest('#appToast').remove()" aria-label="Đóng thông báo">✕</button>
            </div>
        }

        <main id="main-content" role="main" class="main-content">
            @RenderBody()
        </main>

        <footer class="footer-glass">
            <div class="footer-glass__container">
                <p class="footer-glass__copyright">&copy; 2026 COW.AI. Nền tảng trợ lý AI đa tác vụ.</p>
                <div class="footer-glass__links">
                    <a asp-controller="Home" asp-action="Index" class="footer-glass__link">Trang chủ</a>
                    <a asp-controller="Image" asp-action="Index" class="footer-glass__link">Tạo ảnh</a>
                    <a asp-controller="Document" asp-action="Summary" class="footer-glass__link">Tóm tắt</a>
                    <a asp-controller="Document" asp-action="CodeGen" class="footer-glass__link">Viết code</a>
                    <a href="/studio" class="footer-glass__link">Studio</a>
                </div>
            </div>
        </footer>
    </div>

    <!-- COW.AI Workspace & Feature Sidebar Panel (Tham chiếu bố cục Hình 1 & Hình 2) -->
    @{
        var sbCtrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
        var sbAct = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
        var isAuthUser = User.Identity?.IsAuthenticated == true;
        var sbFullName = User.FindFirst("FullName")?.Value ?? User.Identity?.Name ?? "Khách";
        var sbRole = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "Guest";
        var sbAvatar = !string.IsNullOrEmpty(sbFullName) ? sbFullName[0].ToString().ToUpper() : "K";
    }
    <aside id="chatHistoryDrawer" class="chat-drawer cow-sidebar" aria-label="Bảng điều hướng và Dự án COW.AI" aria-hidden="false">
        <!-- Topbar: Brand + Tìm kiếm + Đóng/Mở Panel -->
        <div class="cow-sidebar__topbar">
            <a asp-controller="Home" asp-action="Index" id="sidebarBrandExpandBtn" class="cow-sidebar__brand" title="COW.AI">
                <img src="~/images/logo.png" alt="COW.AI" width="24" height="24" class="cow-sidebar__brand-img" />
                <span class="cow-sidebar__brand-text">COW.AI</span>
            </a>
            <button type="button" id="sidebarRailExpandBtn" class="cow-sidebar__icon-btn cow-sidebar__rail-expand" title="Bật tắt sidebar (Ctrl+Shift+S)" aria-label="Mở rộng thanh điều khiển" data-tooltip="Bật tắt sidebar">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="9" y1="3" x2="9" y2="21"></line></svg>
            </button>
            <div class="cow-sidebar__top-actions">
                <button type="button" id="sidebarSearchToggleBtn" class="cow-sidebar__icon-btn" title="Tìm kiếm dự án & hội thoại" aria-label="Tìm kiếm">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                </button>
                <button type="button" id="closeDrawerBtn" class="cow-sidebar__icon-btn" title="Thu gọn / Mở rộng bảng điều khiển" aria-label="Thu gọn hoặc mở rộng bảng điều khiển">
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="9" y1="3" x2="9" y2="21"></line></svg>
                </button>
            </div>
        </div>

        <!-- Ô lọc nhanh dự án & lịch sử chat -->
        <div id="sidebarSearchWrap" class="cow-sidebar__search-wrap hidden">
            <input type="search" id="sidebarSearchInput" class="cow-sidebar__search-input" placeholder="Tìm dự án hoặc đoạn chat..." aria-label="Tìm dự án hoặc đoạn chat" />
        </div>

        <div class="cow-sidebar__scroll">
            <!-- Nhóm chức năng thực tế của dự án COW.AI -->
            <nav class="cow-sidebar__nav" aria-label="Chức năng COW.AI">
                <button type="button" id="btnNewChat" class="cow-sidebar__nav-item cow-sidebar__nav-item--new @(sbCtrl == "Home" ? "active" : "")" title="Trò chuyện mới">
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                    <span>Trò chuyện mới</span>
                </button>
                <button type="button" id="sidebarRailSearchBtn" class="cow-sidebar__nav-item cow-sidebar__rail-only" title="Tìm kiếm dự án & đoạn chat">
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                    <span>Tìm kiếm</span>
                </button>
                <a asp-controller="Image" asp-action="Index" class="cow-sidebar__nav-item @(sbCtrl == "Image" ? "active" : "")" title="Hình ảnh AI">
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><rect x="3" y="3" width="18" height="18" rx="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
                    <span>Hình ảnh AI</span>
                </a>
                <a asp-controller="Document" asp-action="Summary" class="cow-sidebar__nav-item @(sbCtrl == "Document" && sbAct == "Summary" ? "active" : "")" title="Tóm tắt tài liệu (.md)">
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line></svg>
                    <span>Tóm tắt tài liệu (.md)</span>
                </a>
                <a asp-controller="Document" asp-action="CodeGen" class="cow-sidebar__nav-item @(sbCtrl == "Document" && sbAct == "CodeGen" ? "active" : "")" title="Trợ lý viết code">
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><polyline points="16 18 22 12 16 6"></polyline><polyline points="8 6 2 12 8 18"></polyline></svg>
                    <span>Trợ lý viết code</span>
                </a>
                <a href="/studio" class="cow-sidebar__nav-item" title="Video Studio AI">
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><polygon points="23 7 16 12 23 17 23 7"></polygon><rect x="1" y="5" width="15" height="14" rx="2"></rect></svg>
                    <span>Video Studio AI</span>
                </a>
                <button type="button" id="sidebarPromptLibBtn" class="cow-sidebar__nav-item" title="Thư viện Prompt">
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>
                    <span>Thư viện Prompt</span>
                </button>
            </nav>

            <!-- Mục Dự án Cá nhân (Hình 2: có nút đóng/mở ⌄, tùy chỉnh và dấu + tải dự án từ máy; chỉ mở khi đăng nhập) -->
            <section class="cow-sidebar__section cow-sidebar__projects" aria-label="Dự án cá nhân">
                <div class="cow-sidebar__section-header">
                    <button type="button" id="sidebarProjectsCollapseBtn" class="cow-sidebar__section-toggle" aria-expanded="true" aria-controls="sidebarProjectsBody">
                        <span>Dự án</span>
                        <svg class="cow-sidebar__chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polyline points="6 9 12 15 18 9"></polyline></svg>
                    </button>
                    <div class="cow-sidebar__section-actions">
                        <button type="button" id="sidebarProjectSettingsBtn" class="cow-sidebar__icon-btn cow-sidebar__icon-btn--sm" title="Tùy chỉnh thực thi Dự án đang mở (Auto / Hoàn tác / Tải .zip)" aria-label="Cấu hình dự án">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="4" y1="21" x2="4" y2="14"></line><line x1="4" y1="10" x2="4" y2="3"></line><line x1="12" y1="21" x2="12" y2="12"></line><line x1="12" y1="8" x2="12" y2="3"></line><line x1="20" y1="21" x2="20" y2="16"></line><line x1="20" y1="12" x2="20" y2="3"></line><line x1="1" y1="14" x2="7" y2="14"></line><line x1="9" y1="8" x2="15" y2="8"></line><line x1="17" y1="16" x2="23" y2="16"></line></svg>
                        </button>
                        <button type="button" id="sidebarAddProjectBtn" class="cow-sidebar__icon-btn cow-sidebar__icon-btn--sm" title="@(isAuthUser ? "Đem dự án từ máy lên (+)" : "Đăng nhập để tải dự án lên")" aria-label="Thêm dự án mới">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                        </button>
                    </div>
                </div>

                <div id="sidebarProjectsBody" class="cow-sidebar__section-body">
                    @if (isAuthUser)
                    {
                        <!-- Bảng điều khiển nhanh dự án đang chọn -->
                        <div id="sidebarProjectSettingsPanel" class="cow-sidebar__project-controls hidden">
                            <div class="cow-sidebar__project-controls-row">
                                <label class="workspace-auto-toggle" title="Tự động chạy lệnh xóa mềm / bash không cần hỏi từng bước">
                                    <input type="checkbox" id="sidebarAutoApproveToggle" />
                                    <span>Tự động thực thi (Auto)</span>
                                </label>
                            </div>
                            <div class="cow-sidebar__project-controls-btns">
                                <button type="button" id="sidebarRestoreTrashBtn" class="cow-sidebar__ctrl-btn hidden" title="Khôi phục tệp từ .cowai_trash">
                                    ↩ Hoàn tác (<span id="sidebarTrashCount">0</span>)
                                </button>
                                <a id="sidebarDownloadZipBtn" href="#" class="cow-sidebar__ctrl-btn hidden" title="Tải bản sao .zip của dự án">
                                    ⬇ Tải .zip
                                </a>
                            </div>
                        </div>

                        <div id="sidebarProjectsList" class="cow-sidebar__projects-list">
                            <div class="cow-sidebar__empty">Không có dự án</div>
                        </div>
                    }
                    else
                    {
                        <div class="cow-sidebar__guest-lock">
                            <span>Chỉ hoạt động khi đã đăng nhập.</span>
                            <a asp-controller="Account" asp-action="Login" class="cow-sidebar__guest-link">Đăng nhập để tải dự án →</a>
                        </div>
                    }
                </div>
            </section>

            <!-- Mục Gần đây (Lịch sử hội thoại) -->
            <section class="cow-sidebar__section cow-sidebar__recent" aria-label="Trò chuyện gần đây">
                <div class="cow-sidebar__section-header">
                    <span class="cow-sidebar__section-label">Gần đây</span>
                    <button type="button" id="btnExportChat" class="cow-sidebar__icon-btn cow-sidebar__icon-btn--sm" title="Xuất đoạn chat hiện tại ra Markdown (.md)" aria-label="Xuất Markdown">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
                    </button>
                </div>
                <div class="chat-drawer__list" id="sessionListContainer">
                    <!-- Danh sách session render động từ localStorage -->
                </div>
            </section>
        </div>

        <!-- Footer: Tài khoản, Đổi giao diện, Đăng xuất & Xóa lịch sử -->
        <div class="chat-drawer__footer cow-sidebar__footer">
            @if (isAuthUser)
            {
                <a asp-controller="Account" asp-action="Profile" class="cow-sidebar__user-card" title="Hồ sơ: @sbFullName">
                    <span class="cow-sidebar__avatar">@sbAvatar</span>
                    <span class="cow-sidebar__user-meta">
                        <span class="cow-sidebar__user-name">@sbFullName</span>
                        <span class="cow-sidebar__user-tier">@(sbRole == "Admin" ? "Pro Admin" : "Member")</span>
                    </span>
                </a>
            }
            else
            {
                <a asp-controller="Account" asp-action="Login" class="cow-sidebar__user-card" title="Đăng nhập để mở khóa mục Dự án">
                    <span class="cow-sidebar__avatar">K</span>
                    <span class="cow-sidebar__user-meta">
                        <span class="cow-sidebar__user-name">Khách (Chưa đăng nhập)</span>
                        <span class="cow-sidebar__user-tier">Bấm để đăng nhập</span>
                    </span>
                </a>
            }
            <div class="cow-sidebar__footer-actions">
                <button id="themeToggleBtn" class="cow-sidebar__icon-btn" type="button" aria-label="Đổi giao diện Sáng / Tối" title="Đổi giao diện Sáng / Tối">
                    <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
                    </svg>
                </button>
                <button type="button" id="btnClearAllChats" class="cow-sidebar__icon-btn" title="Xóa toàn bộ lịch sử trò chuyện" aria-label="Xóa toàn bộ lịch sử">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                </button>
                @if (isAuthUser)
                {
                    <form asp-controller="Account" asp-action="Logout" method="post" style="margin:0;display:inline-flex;">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="cow-sidebar__icon-btn" title="Đăng xuất" aria-label="Đăng xuất">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
                        </button>
                    </form>
                }
            </div>
        </div>
    </aside>
    <div id="drawerBackdrop" class="drawer-backdrop" aria-hidden="true"></div>

    <script src="~/lib/marked.min.js" asp-append-version="true"></script>
    <script src="~/lib/prism/prism.min.js" asp-append-version="true"></script>
    <script src="~/lib/prism/prism-csharp.min.js" asp-append-version="true"></script>
    <script src="~/lib/prism/prism-python.min.js" asp-append-version="true"></script>
    <script src="~/js/modules/chat-history-store.js" asp-append-version="true"></script>
    <script src="~/js/modules/voice-input.js" asp-append-version="true"></script>
    <script src="~/js/modules/file-attachment.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/chat-logic.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
