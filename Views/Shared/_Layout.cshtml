<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>@ViewData["Title"] - COW.AI</title>
    <meta name="description" content="@(ViewData["Description"] ?? "COW.AI - Nền tảng trợ lý AI đa tác vụ hàng đầu: Trò chuyện thông minh, sáng tạo hình ảnh, tóm tắt tài liệu văn bản và hỗ trợ lập trình viết code AI tốc độ cao.")" />
    <meta name="robots" content="@(ViewData["Robots"] ?? "index, follow")" />
    <meta name="theme-color" content="#09090b" />
    <link rel="canonical" href="@(ViewData["CanonicalUrl"] ?? $"https://cow.ai{Context.Request.Path}")" />
    <meta property="og:title" content="@ViewData["Title"]" />
    <meta property="og:description" content="@(ViewData["Description"] ?? "Trò chuyện AI, sinh hình ảnh, tóm tắt văn bản và hỗ trợ lập trình thông minh.")" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="COW.AI" />
    <meta property="og:locale" content="vi_VN" />
    <meta property="og:image" content="https://cow.ai/images/logo.png" />
    <meta property="og:url" content="@(ViewData["CanonicalUrl"] ?? $"https://cow.ai{Context.Request.Path}")" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@ViewData["Title"]" />
    <meta name="twitter:description" content="@(ViewData["Description"] ?? "Trò chuyện AI, sinh hình ảnh, tóm tắt văn bản và hỗ trợ lập trình thông minh.")" />
    <meta name="twitter:image" content="https://cow.ai/images/logo.png" />
    @await RenderSectionAsync("Head", required: false)
    <link rel="icon" type="image/png" href="~/images/logo.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/prism/prism-tomorrow.min.css" asp-append-version="true" />
    <script>
        (function () {
            var theme = localStorage.getItem('cowai_theme') || 'dark';
            var isDark = theme === 'dark' || (theme === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches);
            var root = document.documentElement;
            if (isDark) {
                root.classList.add('dark');
                root.classList.remove('light');
            } else {
                root.classList.add('light');
                root.classList.remove('dark');
            }
        })();
    </script>
</head>
<body data-tts-voice="vi-VN-HoaiMyNeural" 
      data-user-id="@(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "guest")" 
      data-user-name="@(User.Identity?.Name ?? "Khách")" 
      data-user-role="@(User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "Guest")">
    <script>
        (function () {
            if (document.documentElement.classList.contains('light')) {
                document.body.classList.add('light');
                document.body.classList.remove('dark');
            } else {
                document.body.classList.add('dark');
                document.body.classList.remove('light');
            }
        })();
    </script>

    <div class="app-wrapper">
        <a href="#main-content" class="skip-to-content-link">Chuyển đến nội dung chính</a>
        <header class="navbar-glass" role="banner" itemscope itemtype="https://schema.org/WPHeader">
            <div class="navbar-container">
                <div class="navbar-brand-group">
                    <button type="button" id="toggleHistoryDrawerBtn" class="nav-drawer-toggle" aria-label="Mở lịch sử trò chuyện" title="Lịch sử chat" aria-expanded="false" aria-controls="chatHistoryDrawer">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <line x1="3" y1="12" x2="21" y2="12"></line>
                            <line x1="3" y1="6" x2="21" y2="6"></line>
                            <line x1="3" y1="18" x2="21" y2="18"></line>
                        </svg>
                    </button>
                    <div class="navbar-brand">
                        <a asp-controller="Home" asp-action="Index" class="brand-logo" rel="home" title="COW.AI - Trợ lý AI Thông minh & Đa tác vụ">
                            <img src="~/images/logo.png" alt="Logo COW.AI" class="brand-logo__image" width="32" height="32" loading="eager" />
                            <span class="brand-name">COW.AI</span>
                        </a>
                    </div>
                </div>

                <!-- Desktop Navigation Menu (Semantic & Chuẩn SEO Schema.org) -->
                @{
                    var navCtrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
                    var navAct = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
                }
                <nav class="navbar-nav desktop-nav" aria-label="Điều hướng chính" role="navigation" itemscope itemtype="https://schema.org/SiteNavigationElement">
                    <ul class="nav-menu-list" role="menubar">
                        <li class="nav-menu-item" role="none">
                            <a asp-controller="Home" asp-action="Index" class="nav-link @(navCtrl == "Home" ? "active" : "")" aria-current="@(navCtrl == "Home" ? "page" : null)" itemprop="url" title="Trang chủ COW.AI - Trò chuyện và trợ lý trực tuyến">
                                <span itemprop="name">Trang chủ</span>
                            </a>
                        </li>
                        <li class="nav-menu-item" role="none">
                            <a asp-controller="Image" asp-action="Index" class="nav-link @(navCtrl == "Image" ? "active" : "")" aria-current="@(navCtrl == "Image" ? "page" : null)" itemprop="url" title="Tạo ảnh nghệ thuật và tranh vẽ bằng AI">
                                <span itemprop="name">Tạo ảnh</span>
                            </a>
                        </li>
                        <li class="nav-menu-item" role="none">
                            <a asp-controller="Document" asp-action="Summary" class="nav-link @(navCtrl == "Document" && navAct == "Summary" ? "active" : "")" aria-current="@(navCtrl == "Document" && navAct == "Summary" ? "page" : null)" itemprop="url" title="Tóm tắt tài liệu và phân tích văn bản nhanh chóng">
                                <span itemprop="name">Tóm tắt</span>
                            </a>
                        </li>
                        <li class="nav-menu-item" role="none">
                            <a asp-controller="Document" asp-action="CodeGen" class="nav-link @(navCtrl == "Document" && navAct == "CodeGen" ? "active" : "")" aria-current="@(navCtrl == "Document" && navAct == "CodeGen" ? "page" : null)" itemprop="url" title="Viết code và sinh thuật toán bằng AI">
                                <span itemprop="name">Viết code</span>
                            </a>
                        </li>
                        <li class="nav-menu-item" role="none">
                            <a href="/studio" target="_blank" rel="noopener noreferrer" class="nav-link" itemprop="url" title="Biên tập và sản xuất video bài giảng AI (Mở tab mới)">
                                <span itemprop="name">Studio ↗</span>
                            </a>
                        </li>
                    </ul>
                </nav>

                <!-- Navbar Actions: Theme Switcher & Account & Mobile Menu Toggle -->
                <div class="navbar-actions">
                    <div class="theme-switcher">
                        <button id="themeToggleBtn" class="theme-btn" type="button" aria-label="Chuyển đổi giao diện Sáng / Tối" title="Đổi giao diện">
                            <svg class="icon-theme" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
                            </svg>
                        </button>
                        <div id="themeDropdownMenu" class="theme-dropdown glass-panel">
                            <button type="button" class="theme-option active" data-theme="dark">Dark</button>
                            <button type="button" class="theme-option" data-theme="light">Light</button>
                            <button type="button" class="theme-option" data-theme="system">System</button>
                        </div>
                    </div>

                    <!-- User Account Action -->
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        var currentFullName = User.FindFirst("FullName")?.Value ?? User.Identity?.Name ?? "User";
                        var currentRole = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "Member";
                        var avatarLetter = !string.IsNullOrEmpty(currentFullName) ? currentFullName[0].ToString().ToUpper() : "U";

                        <div class="user-menu-wrapper">
                            <button id="userMenuBtn" class="user-chip-btn" type="button" aria-label="Menu tài khoản" aria-expanded="false" aria-controls="userDropdownMenu" title="@currentFullName (@currentRole)">
                                <span class="user-avatar-circle">@avatarLetter</span>
                                <span class="user-display-name">@currentFullName</span>
                                <svg class="icon-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <polyline points="6 9 12 15 18 9"></polyline>
                                </svg>
                            </button>
                            <div id="userDropdownMenu" class="user-dropdown-menu glass-panel" aria-hidden="true">
                                <div class="user-dropdown-header">
                                    <div class="user-dropdown-name">@currentFullName</div>
                                    <div class="user-dropdown-role">
                                        <span class="role-pill @(currentRole == "Admin" ? "role-admin" : "role-member")">@(currentRole == "Admin" ? "Quản trị viên" : "Thành viên")</span>
                                    </div>
                                </div>
                                <div class="user-dropdown-divider"></div>
                                <a asp-controller="Account" asp-action="Profile" class="user-dropdown-item">
                                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                                        <circle cx="12" cy="7" r="4"></circle>
                                    </svg>
                                    <span>Hồ sơ cá nhân</span>
                                </a>
                                <div class="user-dropdown-divider"></div>
                                <form asp-controller="Account" asp-action="Logout" method="post" class="logout-menu-form">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="user-dropdown-item user-dropdown-item--danger">
                                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                                            <polyline points="16 17 21 12 16 7"></polyline>
                                            <line x1="21" y1="12" x2="9" y2="12"></line>
                                        </svg>
                                        <span>Đăng xuất</span>
                                    </button>
                                </form>
                            </div>
                        </div>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login" class="btn-nav-login" title="Đăng nhập tài khoản">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"></path>
                                <polyline points="10 17 15 12 10 7"></polyline>
                                <line x1="15" y1="12" x2="3" y2="12"></line>
                            </svg>
                            <span>Đăng nhập</span>
                        </a>
                    }

                    <!-- Mobile Navigation Toggle Button (Hiện khi màn hình <= 768px) -->
                    <button type="button" id="mobileNavToggleBtn" class="mobile-nav-toggle" aria-label="Mở menu điều hướng tính năng" aria-expanded="false" aria-controls="mobileNavMenu" title="Menu tính năng">
                        <svg class="icon-menu-hamburger" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <line x1="4" y1="7" x2="20" y2="7"></line>
                            <line x1="4" y1="12" x2="20" y2="12"></line>
                            <line x1="4" y1="17" x2="20" y2="17"></line>
                        </svg>
                        <svg class="icon-menu-close hidden" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <line x1="18" y1="6" x2="6" y2="18"></line>
                            <line x1="6" y1="6" x2="18" y2="18"></line>
                        </svg>
                    </button>
                </div>
            </div>

            <!-- Mobile Navigation Menu (Collapsible Glass Dropdown) -->
            <div id="mobileNavMenu" class="mobile-nav-menu" aria-label="Menu điều hướng di động" aria-hidden="true">
                <nav class="mobile-nav-container" role="navigation" itemscope itemtype="https://schema.org/SiteNavigationElement">
                    <ul class="mobile-nav-list" role="menu">
                        <li role="none">
                            <a asp-controller="Home" asp-action="Index" class="mobile-nav-item @(navCtrl == "Home" ? "active" : "")" itemprop="url" title="Trang chủ COW.AI">
                                <span class="mobile-nav-icon" aria-hidden="true">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
                                </span>
                                <div class="mobile-nav-info">
                                    <span class="mobile-nav-title" itemprop="name">Trang chủ</span>
                                    <span class="mobile-nav-desc">Trò chuyện đa năng với AI</span>
                                </div>
                            </a>
                        </li>
                        <li role="none">
                            <a asp-controller="Image" asp-action="Index" class="mobile-nav-item @(navCtrl == "Image" ? "active" : "")" itemprop="url" title="Tạo ảnh AI">
                                <span class="mobile-nav-icon" aria-hidden="true">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
                                </span>
                                <div class="mobile-nav-info">
                                    <span class="mobile-nav-title" itemprop="name">Tạo ảnh</span>
                                    <span class="mobile-nav-desc">Sáng tạo hình ảnh từ văn bản</span>
                                </div>
                            </a>
                        </li>
                        <li role="none">
                            <a asp-controller="Document" asp-action="Summary" class="mobile-nav-item @(navCtrl == "Document" && navAct == "Summary" ? "active" : "")" itemprop="url" title="Tóm tắt tài liệu">
                                <span class="mobile-nav-icon" aria-hidden="true">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line></svg>
                                </span>
                                <div class="mobile-nav-info">
                                    <span class="mobile-nav-title" itemprop="name">Tóm tắt</span>
                                    <span class="mobile-nav-desc">Trích xuất ý chính tài liệu</span>
                                </div>
                            </a>
                        </li>
                        <li role="none">
                            <a asp-controller="Document" asp-action="CodeGen" class="mobile-nav-item @(navCtrl == "Document" && navAct == "CodeGen" ? "active" : "")" itemprop="url" title="Viết code AI">
                                <span class="mobile-nav-icon" aria-hidden="true">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><polyline points="16 18 22 12 16 6"></polyline><polyline points="8 6 2 12 8 18"></polyline></svg>
                                </span>
                                <div class="mobile-nav-info">
                                    <span class="mobile-nav-title" itemprop="name">Viết code</span>
                                    <span class="mobile-nav-desc">Sinh mã nguồn &amp; thuật toán</span>
                                </div>
                            </a>
                        </li>
                        <li role="none">
                            <a href="/studio" class="mobile-nav-item" itemprop="url" title="Studio AI">
                                <span class="mobile-nav-icon" aria-hidden="true">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><polygon points="23 7 16 12 23 17 23 7"></polygon><rect x="1" y="5" width="15" height="14" rx="2"></rect></svg>
                                </span>
                                <div class="mobile-nav-info">
                                    <span class="mobile-nav-title" itemprop="name">Studio</span>
                                    <span class="mobile-nav-desc">Sản xuất video AI đa cảnh</span>
                                </div>
                            </a>
                        </li>
                        <li class="mobile-nav-divider" role="separator"></li>
                        <li class="mobile-nav-theme-row" role="none">
                            <span class="mobile-nav-theme-label">Giao diện</span>
                            <div class="mobile-nav-theme-group" role="group" aria-label="Chọn giao diện">
                                <button type="button" class="theme-option mobile-theme-btn" data-theme="dark">Tối</button>
                                <button type="button" class="theme-option mobile-theme-btn" data-theme="light">Sáng</button>
                                <button type="button" class="theme-option mobile-theme-btn" data-theme="system">Hệ thống</button>
                            </div>
                        </li>
                        <li class="mobile-nav-divider" role="separator"></li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            var currentFullName = User.FindFirst("FullName")?.Value ?? User.Identity?.Name ?? "User";
                            var currentRole = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "Member";
                            <li role="none">
                                <a asp-controller="Account" asp-action="Profile" class="mobile-nav-item">
                                    <span class="mobile-nav-icon" aria-hidden="true">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                                    </span>
                                    <div class="mobile-nav-info">
                                        <span class="mobile-nav-title">@currentFullName</span>
                                        <span class="mobile-nav-desc">Hồ sơ cá nhân (@(currentRole == "Admin" ? "Quản trị viên" : "Thành viên"))</span>
                                    </div>
                                </a>
                            </li>
                            <li role="none">
                                <form asp-controller="Account" asp-action="Logout" method="post" style="margin: 0; padding: 0;">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="mobile-nav-item mobile-nav-item--btn" style="width: 100%; text-align: left; background: none; border: none; cursor: pointer;">
                                        <span class="mobile-nav-icon mobile-nav-icon--danger" aria-hidden="true">
                                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
                                        </span>
                                        <div class="mobile-nav-info">
                                            <span class="mobile-nav-title mobile-nav-title--danger">Đăng xuất</span>
                                            <span class="mobile-nav-desc">Thoát khỏi phiên làm việc</span>
                                        </div>
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li role="none">
                                <a asp-controller="Account" asp-action="Login" class="mobile-nav-item">
                                    <span class="mobile-nav-icon" aria-hidden="true">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"></path><polyline points="10 17 15 12 10 7"></polyline><line x1="15" y1="12" x2="3" y2="12"></line></svg>
                                    </span>
                                    <div class="mobile-nav-info">
                                        <span class="mobile-nav-title">Đăng nhập</span>
                                        <span class="mobile-nav-desc">Truy cập tài khoản cá nhân</span>
                                    </div>
                                </a>
                            </li>
                            <li role="none">
                                <a asp-controller="Account" asp-action="Register" class="mobile-nav-item">
                                    <span class="mobile-nav-icon" aria-hidden="true">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="8.5" cy="7" r="4"></circle><line x1="20" y1="8" x2="20" y2="14"></line><line x1="23" y1="11" x2="17" y2="11"></line></svg>
                                    </span>
                                    <div class="mobile-nav-info">
                                        <span class="mobile-nav-title">Đăng ký mới</span>
                                        <span class="mobile-nav-desc">Tạo tài khoản COW.AI Pro</span>
                                    </div>
                                </a>
                            </li>
                        }
                    </ul>
                </nav>
            </div>
        </header>

        @if (TempData["ToastSuccess"] != null || TempData["ToastInfo"] != null)
        {
            <div id="appToast" class="app-toast glass-panel animate-fade-in" role="status" aria-live="polite">
                <div class="app-toast__content">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="@(TempData["ToastSuccess"] != null ? "#34d399" : "#38bdf8")" stroke-width="2">
                        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                        <polyline points="22 4 12 14.01 9 11.01"></polyline>
                    </svg>
                    <span>@(TempData["ToastSuccess"] ?? TempData["ToastInfo"])</span>
                </div>
                <button type="button" class="app-toast__close" onclick="this.closest('#appToast').remove()" aria-label="Đóng thông báo">✕</button>
            </div>
        }

        <main id="main-content" role="main" class="main-content">
            @RenderBody()
        </main>

        <footer class="footer-glass">
            <div class="footer-glass__container">
                <p class="footer-glass__copyright">&copy; 2026 COW.AI. Nền tảng trợ lý AI đa tác vụ.</p>
                <div class="footer-glass__links">
                    <a asp-controller="Home" asp-action="Index" class="footer-glass__link">Trang chủ</a>
                    <a asp-controller="Image" asp-action="Index" class="footer-glass__link">Tạo ảnh</a>
                    <a asp-controller="Document" asp-action="Summary" class="footer-glass__link">Tóm tắt</a>
                    <a asp-controller="Document" asp-action="CodeGen" class="footer-glass__link">Viết code</a>
                    <a href="/studio" class="footer-glass__link">Studio</a>
                </div>
            </div>
        </footer>
    </div>

    <!-- Chat History Drawer (Sidebar) -->
    <aside id="chatHistoryDrawer" class="chat-drawer" aria-label="Lịch sử trò chuyện" aria-hidden="true">
        <div class="chat-drawer__header">
            <div class="chat-drawer__title">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                <span>Lịch sử trò chuyện</span>
            </div>
            <button type="button" id="closeDrawerBtn" class="chat-drawer__close" aria-label="Đóng lịch sử">✕</button>
        </div>
        <div class="chat-drawer__actions">
            <button type="button" id="btnNewChat" class="btn-new-chat">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                <span>Đoạn chat mới</span>
            </button>
            <button type="button" id="btnExportChat" class="btn-export-chat" title="Xuất đoạn chat hiện tại ra Markdown (.md)">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
                <span>Xuất .md</span>
            </button>
        </div>
        <div class="chat-drawer__list" id="sessionListContainer">
            <!-- Danh sách session render động từ localStorage -->
        </div>
        <div class="chat-drawer__footer">
            <button type="button" id="btnClearAllChats" class="btn-clear-all" title="Xóa toàn bộ lịch sử trò chuyện">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                <span>Xóa toàn bộ lịch sử</span>
            </button>
        </div>
    </aside>
    <div id="drawerBackdrop" class="drawer-backdrop" aria-hidden="true"></div>

    <script src="~/lib/marked.min.js" asp-append-version="true"></script>
    <script src="~/lib/prism/prism.min.js" asp-append-version="true"></script>
    <script src="~/lib/prism/prism-csharp.min.js" asp-append-version="true"></script>
    <script src="~/lib/prism/prism-python.min.js" asp-append-version="true"></script>
    <script src="~/js/modules/chat-history-store.js" asp-append-version="true"></script>
    <script src="~/js/modules/voice-input.js" asp-append-version="true"></script>
    <script src="~/js/modules/file-attachment.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/chat-logic.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
