@{
    ViewData["Title"] = "Trợ lý Viết Mã Nguồn & Tối ưu Code AI - Hỗ trợ Đa Ngôn ngữ";
    ViewData["Description"] = "Tạo mã nguồn, giải thuật, debug và refactor code AI với Qwen 2.5 Coder và DeepSeek R1. Hỗ trợ Python, C#, JS, TS, Go, Rust và SQL chuẩn công nghiệp.";
    ViewData["CanonicalUrl"] = "https://cow.ai/Document/CodeGen";
}

@section Head {
    <script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@graph": [
        {
          "@@type": "WebApplication",
          "name": "COW.AI Code Generator",
          "applicationCategory": "DeveloperApplication",
          "operatingSystem": "All",
          "description": "Trợ lý lập trình AI đa ngôn ngữ hỗ trợ viết code, tối ưu giải thuật và fix bug.",
          "offers": { "@@type": "Offer", "price": "0", "priceCurrency": "VND" }
        },
        {
          "@@type": "BreadcrumbList",
          "itemListElement": [
            { "@@type": "ListItem", "position": 1, "name": "Trang chủ", "item": "https://cow.ai/" },
            { "@@type": "ListItem", "position": 2, "name": "Trợ lý viết code", "item": "https://cow.ai/Document/CodeGen" }
          ]
        }
      ]
    }
    </script>
}

<main class="codegen-page ai-app-container">
    <div class="ai-app-layout">
        <!-- Cột trái: Yêu cầu bài toán lập trình -->
        <section class="ai-panel">
            <div class="ai-panel__header">
                <div class="ai-panel__title-group">
                    <h1 class="ai-panel__title">Trợ lý viết code</h1>
                </div>
                <div class="ai-badge ai-badge--tag">
                    <span>Multi-Language</span>
                </div>
            </div>

            <form id="codeGenForm" class="ai-form" onsubmit="return false;">
                <!-- Chọn ngôn ngữ lập trình -->
                <div class="ai-form-group">
                    <label for="codeLanguageSelect" class="ai-label">Ngôn ngữ mục tiêu</label>
                    <select id="codeLanguageSelect" class="form-control ai-select" aria-label="Chọn ngôn ngữ lập trình">
                        <option value="python" selected>Python</option>
                        <option value="csharp">C# (.NET 10)</option>
                        <option value="javascript">JavaScript (ES6+)</option>
                        <option value="typescript">TypeScript</option>
                        <option value="sql">SQL Query</option>
                    </select>
                </div>

                <div class="ai-form-group">
                    <label for="codePromptInput" class="ai-label">
                        <span>Mô tả thuật toán hoặc chức năng cần viết</span>
                    </label>
                    <textarea 
                        id="codePromptInput" 
                        rows="7" 
                        class="form-control ai-textarea" 
                        placeholder="Ví dụ: Viết một class Python để kết nối với OpenRouter API, hỗ trợ streaming response và xử lý lỗi timeout tự động..."
                        aria-label="Yêu cầu lập trình"
                        required
                    ></textarea>
                </div>

                <!-- Tùy chọn sinh code -->
                <div class="ai-form-group">
                    <label class="ai-label">Tiêu chuẩn sinh code</label>
                    <div class="chip-group ai-chips-group" id="codeStandardChips">
                        <button type="button" class="ai-chip active" data-opt="comments" aria-label="Tiêu chuẩn: Chú thích tiếng Việt">Chú thích tiếng Việt</button>
                        <button type="button" class="ai-chip active" data-opt="type-hints" aria-label="Tiêu chuẩn: Type hints">Kèm Type Hints / Static Typing</button>
                        <button type="button" class="ai-chip" data-opt="unit-test" aria-label="Tiêu chuẩn: Kèm Unit Test">Kèm Unit Test</button>
                    </div>
                </div>

                <button type="submit" id="codeSubmitBtn" class="ai-btn-primary" aria-label="Sinh mã nguồn ngay">
                    <span id="codeBtnSpinner" class="ai-spinner hidden"></span>
                    <span id="codeBtnText">Sinh mã nguồn ngay</span>
                </button>
            </form>
        </section>

        <!-- Cột phải: Cửa sổ mã nguồn kết quả (Code Window) -->
        <section class="result-panel ai-panel">
            <div class="ai-panel__header">
                <div class="ai-panel__title-group">
                    <h2 class="ai-panel__title">Mã nguồn kết xuất</h2>
                </div>
                <div class="ai-badge ai-badge--tag" id="codeLangBadge">
                    <span>Python</span>
                </div>
            </div>

            <!-- Cửa sổ Code phong cách macOS Dark Terminal -->
            <div class="code-editor-window">
                <div class="code-editor-header">
                    <div class="code-editor-dots">
                        <span class="code-editor-dot code-editor-dot--red"></span>
                        <span class="code-editor-dot code-editor-dot--yellow"></span>
                        <span class="code-editor-dot code-editor-dot--green"></span>
                    </div>
                    <span id="codeFileNameDisplay" class="code-editor-filename">solution.py</span>
                    <button type="button" id="copyCodeBtn" class="theme-btn" aria-label="Sao chép code">
                        <svg class="icon-send" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                        </svg>
                    </button>
                </div>

                <div id="codeEmptyState" class="image-preview-empty">
                    <div class="image-preview-empty__icon">💻</div>
                    <div class="image-preview-empty__text">Chưa có mã nguồn</div>
                </div>

                <pre id="codeBlockWrapper" class="hidden"><code id="codeOutputBlock" class="language-python"></code></pre>
            </div>

            <!-- Giải thích thuật toán -->
            <div id="codeExplanationBox" class="code-explanation-card hidden">
                <strong>💡 Giải thích thuật toán:</strong>
                <p id="codeExplanationText" class="mt-2 mb-0"></p>
            </div>
        </section>
    </div>
</main>

@section Scripts {
    <script src="~/lib/prism/prism.min.js"></script>
    <script src="~/lib/prism/prism-python.min.js"></script>
    <script src="~/lib/prism/prism-csharp.min.js"></script>
}
