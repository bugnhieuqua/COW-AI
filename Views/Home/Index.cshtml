@{
    ViewData["Title"] = "COW.AI - Trợ lý AI Đa Năng Thông minh & Bảo mật Riêng tư";
    ViewData["Description"] = "COW.AI - Nền tảng trợ lý trí tuệ nhân tạo: Chat thông minh, lập trình viết code, tóm tắt tài liệu và sản xuất video bài giảng AI tự động. 100% riêng tư và tức thì.";
    ViewData["CanonicalUrl"] = "https://cow.ai";
}

@section Head {
    <script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@graph": [
        {
          "@@type": "WebSite",
          "name": "COW.AI",
          "url": "https://cow.ai",
          "inLanguage": "vi-VN"
        },
        {
          "@@type": "SoftwareApplication",
          "name": "COW.AI Platform",
          "applicationCategory": "AIPlatform",
          "operatingSystem": "All",
          "description": "Nền tảng trí tuệ nhân tạo đa tác vụ hỗ trợ chat, tạo ảnh, tóm tắt văn bản và biên tập video bài giảng.",
          "offers": {
            "@@type": "Offer",
            "price": "0",
            "priceCurrency": "VND"
          }
        }
      ]
    }
    </script>
}

<div class="chat-app-viewport" id="chatAppViewport">
    <!-- 1. Mid Section: Khung Lịch Sử Hội Thoại (Chiếm flex: 1 khi ở Bottom Mode) -->
    <div class="chat-history-wrapper" id="chatHistoryWrapper">
        <div class="chat-history-scroll" id="chatHistory" role="log" aria-live="polite">
            <!-- Tin nhắn User & AI sẽ được append động vào đây -->
        </div>
    </div>

    <!-- 2. Bottom Section: Khung Prompt Bar & Suggestions -->
    <div class="chat-dock-section" id="chatDockSection">
        <div class="chat-dock-inner">
            <!-- Welcome Hero Header: Logo & Dòng chữ Phía trên đoạn chat (Tham chiếu Duck.ai - Hình 2) -->
            <div class="chat-hero-header" id="chatHeroHeader">
                <div class="chat-standalone-logo">
                    <img src="~/images/logo.png" alt="COW.AI Mascot" class="chat-standalone-logo__img" />
                </div>

                <h1 class="chat-hero-title">
                    <span class="brand-title-accent">COW.AI</span> — Trợ lý AI của bạn
                </h1>

              
            </div>
            <!-- Prompt Bar Form -->
            <form id="chatPromptForm" class="prompt-form" onsubmit="return false;">
                <input type="file" id="chatFileInput" class="hidden" accept=".pdf,.docx,.pptx,.xlsx,.csv,.html,.htm,.epub,.ipynb,.json,.xml,.txt,.md,.cs,.py,.js,.ts,.sql,.css" style="display:none;" />
                <input type="file" id="chatFolderInput" class="hidden" webkitdirectory directory multiple style="display:none;" />

                <!-- Menu Slash Skills (Hiện tự động khi gõ / hoặc bấm nút /) -->
                <div id="skillsPopover" class="skills-popover hidden" role="listbox" aria-label="Danh sách kỹ năng COW.AI"></div>

                <!-- Popover Thư mục AI Agent -->
                <div id="folderAgentPopover" class="folder-agent-popover hidden" role="dialog" aria-label="Chọn thư mục dự án">
                    <div class="folder-agent-popover__header">
                        <div class="folder-agent-popover__title-group">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path></svg>
                            <span>Thư mục Dự án</span>
                        </div>
                        <button type="button" id="btnCloseFolderPopover" class="folder-agent-close" aria-label="Đóng">✕</button>
                    </div>

                    <div class="folder-agent-popover__body">
                        <div class="folder-agent-upload-row">
                            <button type="button" id="btnPickNativeOsFolder" class="folder-agent-btn folder-agent-btn--primary">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path></svg>
                                <span>Mở Explorer chọn thư mục</span>
                            </button>
                        </div>

                        <div class="folder-agent-path-row">
                            <input type="text" id="folderPathInput" class="folder-agent-input" placeholder="Hoặc dán đường dẫn (D:\MyProject)..." aria-label="Đường dẫn thư mục" />
                            <button type="button" id="btnReadServerFolder" class="folder-agent-btn folder-agent-btn--accent">Mở</button>
                        </div>

                        <div id="folderAgentStatus" class="folder-agent-status hidden"></div>
                    </div>
                </div>

                <!-- Thư viện Prompt Mẫu cục bộ (100% LocalStorage riêng tư) -->
                <div id="promptLibraryPopover" class="prompt-library-popover hidden" role="dialog" aria-label="Thư viện Prompt mẫu">
                    <div class="prompt-library-popover__head">
                        <span class="prompt-library-popover__title">Thư viện Prompt mẫu (Riêng tư)</span>
                        <button type="button" id="btnSavePromptTemplate" class="prompt-library-save-btn" title="Lưu nội dung đang nhập thành mẫu mới">+ Lưu ô nhập</button>
                    </div>
                    <div id="promptLibraryList" class="prompt-library-list"></div>
                </div>

                <div class="gradient-border-box">
                    <div class="input-card">
                        <!-- Thông báo Chế độ Đọc giọng nói (TTS) -->
                        <div id="ttsModeNotice" class="tts-mode-banner hidden">
                            <span class="tts-mode-banner__icon" aria-hidden="true">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"></path><path d="M19 10v2a7 7 0 0 1-14 0v-2"></path><line x1="12" y1="19" x2="12" y2="23"></line></svg>
                            </span>
                            <span class="tts-mode-banner__text">Đang ở chế độ tạo giọng đọc âm thanh</span>
                            <button type="button" id="btnExitTtsMode" class="tts-mode-banner__btn" title="Chuyển về Chat AI">✕ Quay lại Chat AI</button>
                        </div>

                        <!-- Thanh Workspace gắn 1-1 với phiên Chat hiện tại -->
                        <div id="activeWorkspaceBanner" class="workspace-banner hidden" role="region" aria-label="Thư mục Workspace đang gắn với đoạn chat">
                            <div class="workspace-banner__info">
                                <span class="workspace-banner__icon" aria-hidden="true">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path></svg>
                                </span>
                                <span class="workspace-banner__name" id="workspaceBannerName">Workspace</span>
                                <span class="workspace-banner__meta" id="workspaceBannerMeta">0 tệp · Agent sẵn sàng</span>
                            </div>
                            <div class="workspace-banner__actions">
                                <label class="workspace-auto-toggle" title="Tự động chạy lệnh xóa mềm / bash không cần hỏi từng bước">
                                    <input type="checkbox" id="workspaceAutoApproveToggle" />
                                    <span>Auto</span>
                                </label>
                                <button type="button" id="workspaceRebindRealBtn" class="workspace-banner__btn hidden" title="Đổi thư mục dự án">
                                    🔗 Đổi thư mục
                                </button>
                                <button type="button" id="workspaceRestoreTrashBtn" class="workspace-banner__btn hidden" title="Khôi phục tệp đã chuyển vào .cowai_trash">
                                    ↩ Hoàn tác (<span id="workspaceTrashCount">0</span>)
                                </button>
                                <a id="workspaceDownloadZipBtn" href="#" class="workspace-banner__btn hidden" title="Tải xuống bản sao .zip của thư mục sau khi Agent xử lý">
                                    ⬇ .zip
                                </a>
                                <button type="button" id="workspaceUnbindBtn" class="workspace-banner__close" title="Gỡ liên kết thư mục khỏi đoạn chat này" aria-label="Gỡ thư mục">✕</button>
                            </div>
                        </div>

                        <!-- Vùng preview tệp đính kèm -->
                        <div id="attachmentPreviewArea" class="attachment-preview-area hidden"></div>

                        <textarea 
                            id="promptInput" 
                            name="prompt" 
                            rows="1" 
                            placeholder="Hỏi bất kỳ điều gì hoặc gõ / để chọn kỹ năng (/folder, /imags, /code)..." 
                            class="prompt-input prompt-textarea"
                            aria-label="Nhập lệnh cho AI"
                            aria-autocomplete="list"
                            aria-controls="skillsPopover"
                        ></textarea>

                        <div class="input-card-footer">
                            <div class="input-card-footer__left">
                                <button type="button" class="btn-attach" id="attachBtn" aria-label="Đính kèm tệp" title="Đính kèm tệp văn bản / mã nguồn">
                                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M12 5v14M5 12h14"/></svg>
                                </button>
                                <button type="button" class="btn-attach-folder" id="attachFolderBtn" aria-label="Truy cập thư mục cho AI Agent (/folder)" title="Chọn thư mục dự án (/folder)" aria-haspopup="dialog" aria-expanded="false">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path></svg>
                                    <span>Thư mục</span>
                                </button>
                                <button type="button" class="btn-skills-trigger" id="skillsTriggerBtn" aria-label="Mở danh sách kỹ năng (/)" title="Kỹ năng nhanh (/imags, /code...)" aria-haspopup="listbox" aria-expanded="false">
                                    <span class="btn-skills-trigger__slash">/</span>
                                    <span class="btn-skills-trigger__label">Skills</span>
                                </button>
                                <button type="button" class="btn-prompt-library" id="promptLibraryBtn" aria-label="Mở thư viện Prompt mẫu" title="Thư viện Prompt mẫu (LocalStorage)" aria-haspopup="dialog" aria-expanded="false">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path></svg>
                                    <span>Mẫu</span>
                                </button>
                                <partial name="_ModelSelector" />
                                <span id="homeImageQuotaBadge" class="home-image-quota-pill" title="Giới hạn tạo tối đa 5 ảnh tại Trang chủ + 5 ảnh tại Trang tạo ảnh (tổng 10 ảnh)">Ảnh: 0/5</span>
                            </div>

                            <div class="input-card-footer__right">
                                <button type="button" class="btn-voice" id="voiceInputBtn" aria-label="Nhập bằng giọng nói" title="Nhập bằng giọng nói (Tiếng Việt)">
                                    <svg class="icon-mic" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"></path>
                                        <path d="M19 10v2a7 7 0 0 1-14 0v-2"></path>
                                        <line x1="12" y1="19" x2="12" y2="23"></line>
                                        <line x1="8" y1="23" x2="16" y2="23"></line>
                                    </svg>
                                </button>
                                <button type="submit" id="submitBtn" class="prompt-submit btn-send" aria-label="Gửi lệnh">
                                    <span>Gửi</span>
                                    <svg class="icon-send" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M12 5l7 7-7 7" />
                                    </svg>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </form>

            <!-- Suggestion Prompts & Features Grid (Ẩn mượt mà khi vào Bottom Mode) -->
            <div class="chat-suggestions-group" id="chatSuggestionsGroup">
                <div class="example-prompts">
                    <button type="button" class="example-prompt-btn" data-prompt="Vẽ tranh sơn dầu một chú bò phi hành gia bay lơ lửng giữa dải ngân hà neon" aria-label="Prompt mẫu: Bò phi hành gia">
                        <span class="example-prompt-btn__content">
                            <svg class="example-prompt-btn__lead" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><rect x="3" y="3" width="18" height="18" rx="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
                            <span>Tạo ảnh: Bò phi hành gia giữa dải ngân hà neon</span>
                        </span>
                        <svg class="example-prompt-btn__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                        </svg>
                    </button>
                    <button type="button" class="example-prompt-btn" data-prompt="Tóm tắt các điểm then chốt của quy trình kiểm soát chất lượng phần mềm OWASP" aria-label="Prompt mẫu: Kiểm soát OWASP">
                        <span class="example-prompt-btn__content">
                            <svg class="example-prompt-btn__lead" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="8" y1="13" x2="16" y2="13"></line><line x1="8" y1="17" x2="13" y2="17"></line></svg>
                            <span>Tóm tắt: Quy trình kiểm soát bảo mật OWASP</span>
                        </span>
                        <svg class="example-prompt-btn__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                        </svg>
                    </button>
                    <button type="button" class="example-prompt-btn" data-prompt="Viết code Python thuật toán Dijkstra tìm đường đi ngắn nhất có chú thích chi tiết" aria-label="Prompt mẫu: Thuật toán Dijkstra">
                        <span class="example-prompt-btn__content">
                            <svg class="example-prompt-btn__lead" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><polyline points="16 18 22 12 16 6"></polyline><polyline points="8 6 2 12 8 18"></polyline></svg>
                            <span>Viết code: Thuật toán Dijkstra bằng Python</span>
                        </span>
                        <svg class="example-prompt-btn__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                        </svg>
                    </button>
                    <button type="button" class="example-prompt-btn" data-prompt="Giải thích nguyên lý hoạt động của mạng nơ-ron tích chập (CNN) cho người mới bắt đầu" aria-label="Prompt mẫu: Mạng CNN">
                        <span class="example-prompt-btn__content">
                            <svg class="example-prompt-btn__lead" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><circle cx="12" cy="12" r="10"></circle><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
                            <span>Giải thích: Nguyên lý hoạt động của mạng CNN</span>
                        </span>
                        <svg class="example-prompt-btn__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                        </svg>
                    </button>
                </div>

                <!-- Feature quick links -->
                <div class="features-grid">
                    <article class="feature-card-wrapper">
                        <a asp-controller="Image" asp-action="Index" class="feature-card">
                            <div class="feature-card__icon-wrapper" aria-hidden="true">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><rect x="3" y="3" width="18" height="18" rx="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
                            </div>
                            <h2 class="feature-card__title">Tạo ảnh AI</h2>
                        </a>
                    </article>
                    <article class="feature-card-wrapper">
                        <a asp-controller="Document" asp-action="Summary" class="feature-card">
                            <div class="feature-card__icon-wrapper" aria-hidden="true">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="8" y1="13" x2="16" y2="13"></line><line x1="8" y1="17" x2="13" y2="17"></line></svg>
                            </div>
                            <h2 class="feature-card__title">Tóm tắt tài liệu</h2>
                        </a>
                    </article>
                    <article class="feature-card-wrapper">
                        <a asp-controller="Document" asp-action="CodeGen" class="feature-card">
                            <div class="feature-card__icon-wrapper" aria-hidden="true">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><polyline points="16 18 22 12 16 6"></polyline><polyline points="8 6 2 12 8 18"></polyline></svg>
                            </div>
                            <h2 class="feature-card__title">Trợ lý viết code</h2>
                        </a>
                    </article>
                </div>
            </div>
        </div>
    </div>

    <!-- Khung hiển thị kết quả AI (Auxiliary/legacy container bảo toàn tương thích) -->
    <div id="aiResponseContainer" class="ai-response-container chat-result-wrapper hidden" style="display:none;" aria-hidden="true">
        <div id="chatBoxCard" class="ai-response-card glass-panel hidden">
            <div class="ai-response-card__header result-header">
                <div class="ai-response-card__title">
                    <span class="ai-status-indicator pulse"></span>
                    <span id="responseModelBadge" class="model-name">Gemini 2.0 Flash</span>
                </div>
                <div class="ai-response-card__actions">
                    <button type="button" id="copyChatBtn" class="ai-btn-action btn-copy" title="Sao chép nội dung">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
                        <span>Sao chép</span>
                    </button>
                    <button type="button" id="clearChatBtn" class="ai-btn-action" title="Đóng phản hồi">✕</button>
                </div>
            </div>
            <div id="chatBox" class="ai-response-box response-content prose"></div>
        </div>

        <div id="imageBoxCard" class="ai-response-card glass-panel hidden">
            <div class="ai-response-card__header">
                <div class="ai-response-card__title">
                    <span class="ai-status-indicator"></span>
                    <span>Tác phẩm tạo bởi Pollinations AI</span>
                </div>
                <div class="ai-response-card__actions">
                    <a id="downloadImageResultBtn" href="#" target="_blank" download="cow-ai-artwork.jpg" class="ai-btn-action">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
                        <span>Tải ảnh</span>
                    </a>
                    <button type="button" id="clearImageBtn" class="ai-btn-action" title="Đóng ảnh">✕</button>
                </div>
            </div>
            <div class="ai-image-wrapper">
                <img id="imageResult" class="ai-image-result" src="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1 1'%3E%3C/svg%3E" alt="Ảnh kết quả tạo bởi AI" loading="lazy" />
            </div>
        </div>
    </div>
</div>
